{
  "name": "angular-components",
  "version": "3.7.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href /angular-components/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:shuffle": "ng test --watch=false --runner-config=vitest-shuffle.config.mts",
    "release": "commit-and-tag-version",
    "release:rc": "commit-and-tag-version --prerelease rc",
    "serve:ssr:angular-components": "node dist/angular-components/server/server.mjs",
    "check:css": "node scripts/check-css-fallbacks.mjs",
    "docs:copy": "node scripts/copy-manifest.mjs",
    "check:copy": "node scripts/copy-manifest.mjs --check",
    "check:copy-compile": "node scripts/check-copy-compile.mjs",
    "docs:pages": "node scripts/build-component-docs.mjs",
    "check:pages": "node scripts/build-component-docs.mjs --check"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.2.7",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.7",
    "@angular-devkit/schematics": "^22.2.7",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.3.0",
    "@types/express": "^5.0.1",
    "@types/node": "^24.19.2",
    "axe-core": "4.14.0",
    "commit-and-tag-version": "^13.3.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
